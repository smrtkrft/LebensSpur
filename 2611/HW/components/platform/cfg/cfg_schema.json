{
  "_doc": "LebensSpur 2611 yapilandirma semasi. Tek kaynak: C yapilari, alan tablosu, NVS blob'lari, API alan adlari ve GUI formu buradan uretilir (tools/gen_cfg.py). str len = azami karakter (tampon len+1). flags: secret = API'de *** ve logda yok; internal = API'den hic okunmaz/yazilmaz.",
  "sections": {
    "device":     [{"name": "ap_enabled", "type": "bool", "default": true},
                   {"name": "ap_pass", "type": "str", "len": 63, "secret": true}],
    "wifi_p":     [{"name": "ssid", "type": "str", "len": 32},
                   {"name": "pass", "type": "str", "len": 64, "secret": true},
                   {"name": "hidden", "type": "bool", "default": false},
                   {"name": "ip", "type": "str", "len": 15},
                   {"name": "gw", "type": "str", "len": 15},
                   {"name": "mask", "type": "str", "len": 15},
                   {"name": "dns", "type": "str", "len": 15}],
    "wifi_b":     [{"name": "ssid", "type": "str", "len": 32},
                   {"name": "pass", "type": "str", "len": 64, "secret": true},
                   {"name": "hidden", "type": "bool", "default": false},
                   {"name": "ip", "type": "str", "len": 15},
                   {"name": "gw", "type": "str", "len": 15},
                   {"name": "mask", "type": "str", "len": 15},
                   {"name": "dns", "type": "str", "len": 15}],
    "wifi_tx":    [{"name": "max_q", "type": "u8", "min": 28, "max": 80, "default": 66},
                   {"name": "adaptive", "type": "bool", "default": true}],
    "timer":      [{"name": "unit", "type": "enum", "values": ["min", "hour", "day"], "default": "day"},
                   {"name": "value", "type": "u8", "min": 1, "max": 60, "default": 7},
                   {"name": "warn_count", "type": "u8", "min": 1, "max": 10, "default": 3},
                   {"name": "warn_first_s", "type": "u32", "min": 0, "max": 5184000, "default": 0}],
    "relay":      [{"name": "inverted", "type": "bool", "default": false},
                   {"name": "delay_s", "type": "u8", "min": 0, "max": 60, "default": 0},
                   {"name": "pulse_s", "type": "u8", "min": 0, "max": 60, "default": 0},
                   {"name": "duration_s", "type": "u16", "min": 0, "max": 3600, "default": 0}],
    "smtp":       [{"name": "server", "type": "str", "len": 63},
                   {"name": "port", "type": "u16", "min": 1, "max": 65535, "default": 465},
                   {"name": "user", "type": "str", "len": 63},
                   {"name": "pass", "type": "str", "len": 63, "secret": true},
                   {"name": "tls_verify", "type": "bool", "default": true}],
    "telegram":   [{"name": "token", "type": "str", "len": 71, "secret": true},
                   {"name": "chat_id", "type": "str", "len": 31},
                   {"name": "message", "type": "str", "len": 512}],
    "webhook":    [{"name": "url", "type": "str", "len": 255},
                   {"name": "method", "type": "enum", "values": ["POST", "GET", "PUT"], "default": "POST"},
                   {"name": "headers", "type": "str", "len": 255},
                   {"name": "body", "type": "str", "len": 511}],
    "mqtt":       [{"name": "url", "type": "str", "len": 127},
                   {"name": "topic", "type": "str", "len": 127},
                   {"name": "user", "type": "str", "len": 63},
                   {"name": "pass", "type": "str", "len": 63, "secret": true},
                   {"name": "payload", "type": "str", "len": 255},
                   {"name": "retain", "type": "bool", "default": false}],
    "early_mail": [{"name": "email", "type": "str", "len": 63},
                   {"name": "subject", "type": "str", "len": 128},
                   {"name": "body", "type": "str", "len": 2048}],
    "actions":    [{"name": "early_mail", "type": "bool", "default": false},
                   {"name": "early_telegram", "type": "bool", "default": false},
                   {"name": "early_webhook", "type": "bool", "default": false},
                   {"name": "early_mqtt", "type": "bool", "default": false},
                   {"name": "trig_mail", "type": "bool", "default": false},
                   {"name": "trig_webhook", "type": "bool", "default": false},
                   {"name": "trig_mqtt", "type": "bool", "default": false},
                   {"name": "trig_relay", "type": "bool", "default": true}],
    "remote":     [{"name": "enabled", "type": "bool", "default": false},
                   {"name": "key", "type": "str", "len": 26, "secret": true}],
    "auth":       [{"name": "hash", "type": "str", "len": 64, "internal": true},
                   {"name": "ttl_min", "type": "u16", "min": 1, "max": 1440, "default": 10},
                   {"name": "protect", "type": "bool", "default": true},
                   {"name": "lock_min", "type": "u8", "min": 1, "max": 60, "default": 15}]
  },
  "group": {
    "count": 10,
    "fields": [{"name": "used", "type": "bool", "default": false, "internal": true},
               {"name": "name", "type": "str", "len": 63},
               {"name": "subject", "type": "str", "len": 128},
               {"name": "body", "type": "str", "len": 2048},
               {"name": "recipients", "type": "str", "len": 512}]
  }
}
