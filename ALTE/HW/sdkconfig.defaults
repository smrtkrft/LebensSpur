# ============================================
# LebensSpur - ESP32-C6 SDK Configuration
# ============================================

# --- Target ---
CONFIG_IDF_TARGET="esp32c6"

# --- Flash (Dahili 4MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Partition Table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- OTA ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- WiFi ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# --- HTTP Server ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- LWIP (max_open_sockets=13 icin: 13+3=16 socket gerekli) ---
CONFIG_LWIP_MAX_SOCKETS=16

# --- TLS/SSL (SMTP icin) ---
CONFIG_ESP_TLS_USING_MBEDTLS=y

# --- NVS ---
CONFIG_NVS_ENCRYPTION=n

# --- Watchdog / Panic (donma -> reset -> sys_log kaydi) ---
# TWDT varsayilanda sadece uyari basar, cihaz donuk kalir. PANIC=y ile reset atar
# ve sys_log bir sonraki acilista "task_wdt" olarak kaydeder.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Brownout dedektoru acik: besleme dususlerinde ESP_RST_BROWNOUT nedeni uretilir
CONFIG_ESP_BROWNOUT_DET=y
# WiFi event handler icinde loglama/dosya yazimi var: varsayilan 2304 yigin dar
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# --- Konsol: USB Serial/JTAG ---
# UART0 TX/RX = GPIO16/17 = harici flash SCLK (D6) ve D7! UART konsolu acilista
# SCLK hattina log basiyordu; flash cipi acilista cop saat darbeleri aliyordu.
# XIAO ESP32-C6 USB-C uzerinden zaten USB Serial/JTAG ile izlenir.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Log Level ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ============================================
# Boyut: dahili flash (uygulama bolumu 1984 KB). Teshis ozellikleri (assert metinleri,
# mbedTLS hata metinleri, esp_err_to_name) BILEREK aciktir; WPA3 de korunur.
# ============================================
# Derleyici: -Og (varsayilan, hata ayiklama) yerine -Os. Islevsel fark yok.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Sertifika paketi: yalnizca yaygin kok CA'lar (~%50 kucuk, ~%99 kapsama). Gmail/Outlook/
# Proton, Telegram, GitHub, Let's Encrypt, Amazon, DigiCert, GlobalSign, Sectigo dahil.
# SMTP dogrulamasi zaten OPTIONAL (teslimat oncelikli); webhook/mqtts icin nadir bir
# bolgesel CA gerekirse CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE ile eklenir.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# IPv6 kullanilmiyor (SMTP AF_INET, tum servisler IPv4). mDNS A kaydiyla calisir.
CONFIG_LWIP_IPV6=n
# TLS sunucu yok (HTTPS server kullanilmiyor); mbedTLS yalnizca istemci
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
# Kullanilmayan mbedTLS ozellikleri
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
# Acik web PKI yalnizca P-256/P-384 (P-521 ve X25519 korunur); Brainpool/Koblitz/192-224 bit kapali
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
# MQTT yalnizca mqtt:// ve mqtts:// (WebSocket tasima yok)
CONFIG_WS_TRANSPORT=n
# mDNS: yalnizca duyuru (tarama, konsol CLI, coklu ornek kullanilmiyor)
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_MULTIPLE_INSTANCE=n
